 
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String
  description String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("expense_categories")
}

model ExpenseStatus {
  id        Int       @id @default(autoincrement())
  name      String
  description String?
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("expense_statuses")
}

model Expense {
  id          Int             @id @default(autoincrement())
  lotId       Int
  lot         Lot             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  purchaseId  Int?            
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusId    Int
  status      ExpenseStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("expenses")
}
