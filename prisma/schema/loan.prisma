
model LoanStatus {
  id        Int    @id @default(autoincrement())
  name      String
  description String?
  loans     Loan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loan_statuses")
}

model Loan {
  id          Int        @id @default(autoincrement())
  purchaseId  Int
  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  lotId       Int
  lot         Lot        @relation(fields: [lotId], references: [id], onDelete: Restrict)
  statusId    Int
  status      LoanStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  amount      Float
  description String?
  cashAmount  Float      
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("loans")
}
